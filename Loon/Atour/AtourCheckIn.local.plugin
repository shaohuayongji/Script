#!name=亚朵签到（本地脚本）
#!desc=获取 App 签到页登录信息；每日 08:40 查询并尝试签到；遇验证码需在 App 完成。

[Script]
http-response ^https://miniapp\.yaduo\.com/atourlife/signIn/(?:indexInfoV2|signIn)(?:\?|$) script-path=atour.loon.js,requires-body=true,binary-body-mode=false,timeout=10,tag=亚朵获取登录信息,enable=true
cron "40 8 * * *" script-path=atour.loon.js,timeout=90,tag=亚朵签到,enable=true
generic script-path=atour.loon.js,timeout=90,tag=亚朵签到（手动）,enable=true

[Mitm]
hostname=miniapp.yaduo.com
