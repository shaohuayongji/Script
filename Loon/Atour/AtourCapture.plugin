#!name=亚朵获取登录信息
#!desc=R4：临时启用。只读取状态请求的登录信息，不读取响应正文。收到候选信息通知后关闭本插件，日常仅启用签到插件。

[Script]
http-request ^https://miniapp\.yaduo\.com/atourlife/signIn/indexInfoV2(?:\?|$) script-path=https://raw.githubusercontent.com/shaohuayongji/Script/master/Loon/Atour/atour.capture.js?v=20261004-4,requires-body=false,timeout=5,tag=亚朵获取登录信息,enable=true

[Mitm]
hostname=miniapp.yaduo.com
