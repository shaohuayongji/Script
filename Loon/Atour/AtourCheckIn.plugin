#!name=亚朵签到
#!desc=R2：签名头与登录信息分开处理；增加“亚朵签到（手动）”入口。每日 08:40 查询并尝试签到，要求验证码时需在 App 完成。

[Script]
http-response ^https://miniapp\.yaduo\.com/atourlife/signIn/(?:indexInfoV2|signIn)(?:\?|$) script-path=https://raw.githubusercontent.com/shaohuayongji/Script/master/Loon/Atour/atour.loon.js?v=20261004-2,requires-body=true,binary-body-mode=false,timeout=10,tag=亚朵获取登录信息,enable=true
cron "40 8 * * *" script-path=https://raw.githubusercontent.com/shaohuayongji/Script/master/Loon/Atour/atour.loon.js?v=20261004-2,timeout=90,tag=亚朵签到,enable=true
generic script-path=https://raw.githubusercontent.com/shaohuayongji/Script/master/Loon/Atour/atour.loon.js?v=20261004-2,timeout=90,tag=亚朵签到（手动）,enable=true

[Mitm]
hostname=miniapp.yaduo.com
